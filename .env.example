# Database (Optional for dev, required for prod)
DATABASE_URL=

# GitHub Personal Access Token (for rate limit boost up to 5,000 req/hr)
GITHUB_TOKEN=

# Redis Queue (Optional in dev, runs in-memory fallback)
REDIS_URL=

# AI Provider Configuration: auto | groq | openrouter | gemini | ollama
AI_PROVIDER=auto

# ── 1. Groq (Ultra-Fast Free Tier — https://console.groq.com/keys) ───────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── 2. OpenRouter (Free Tier Models — https://openrouter.ai/keys) ─────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── 3. Google Gemini (100% Free via Google AI Studio — https://aistudio.google.com) 
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── 4. Local Ollama (100% Free, Zero Key, Local GPU/CPU) ─────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:latest
